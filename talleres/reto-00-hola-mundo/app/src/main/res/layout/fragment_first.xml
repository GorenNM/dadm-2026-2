<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".FirstFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:id="@+id/textview_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lorem_ipsum"
            android:textColor="@color/wiki_text"
            android:textSize="32sp"
            android:fontFamily="serif"
            android:textStyle="normal" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/textview_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wiki_subtitle"
            android:textColor="@color/wiki_text"
            android:textSize="12sp"
            android:paddingBottom="8dp" />

        <!-- Main Separator -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/wiki_separator"
            android:layout_marginBottom="16dp" />

        <!-- Main Content -->
        <TextView
            android:id="@+id/textview_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wiki_content"
            android:textColor="@color/wiki_text"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Section: Historia -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wiki_section_history"
            android:textColor="@color/wiki_text"
            android:textSize="22sp"
            android:fontFamily="serif"
            android:layout_marginBottom="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/wiki_separator"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wiki_history_content"
            android:textColor="@color/wiki_text"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Action Button (mimicking a link) -->
        <Button
            android:id="@+id/button_first"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wiki_more_info"
            android:textColor="@color/wiki_link"
            android:textAllCaps="false"
            android:layout_gravity="start" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>