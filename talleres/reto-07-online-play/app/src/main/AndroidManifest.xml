<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Firebase ya lo declara en su manifest; se deja explícito porque el modo en línea depende de esto -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".TicTacToeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TicTacToe">
        <!-- Pantalla inicial: la lista de juegos disponibles (enunciado del reto 07) -->
        <activity
            android:name=".online.LobbyActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".online.OnlineGameActivity"
            android:exported="false" />
        <!-- Modo sin conexión, el triqui del reto 06 -->
        <activity
            android:name=".AndroidTicTacToeActivity"
            android:exported="false"
            android:label="@string/lobby_play_offline" />
    </application>

</manifest>
